# Endereço do backend (sem barra no final).
# Local: http://localhost:3001 | Produção: https://seu-backend.vercel.app
VITE_API_URL=http://localhost:3001

# Opcionais (nas variáveis do projeto do frontend na Vercel):
# SITE_URL=https://seudominio.com.br            # domínio público; na Vercel já vem automático
# GOOGLE_SITE_VERIFICATION=                     # código "meta" do Google Search Console
# VITE_TURNSTILE_SITE_KEY=                      # anti-robô (Cloudflare Turnstile), junto com TURNSTILE_SECRET_KEY no backend
