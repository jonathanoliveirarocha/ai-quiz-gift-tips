# Chave da API do Gemini: https://aistudio.google.com/apikey
# Sem chave, o site funciona em modo demonstracao (sugestoes sem IA).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB. Se nao houver servidor nesse endereco, o backend sobe um MongoDB embutido
# com os dados em backend/.data (o primeiro start baixa o binario do MongoDB).
MONGODB_URI=mongodb://127.0.0.1:27017/presente-certo
MONGODB_EMBEDDED=true

PORT=3001

# Token da API de administracao do catalogo (/api/admin). Vazio = admin desativado.
ADMIN_TOKEN=

# ---------- Afiliados (opcional) ----------
# Amazon Associados: sua tag, ex.: meusite-20
AMAZON_ASSOCIATE_TAG=
# Outras lojas: modelo de deep link do seu programa/rede de afiliados.
# {url} = link da loja ja codificado | {query} = termo de busca codificado
# Ex.: AFFILIATE_TEMPLATE_MAGALU=https://www.awin1.com/cread.php?awinmid=000&awinaffid=000&ued={url}
AFFILIATE_TEMPLATE_MERCADOLIVRE=
AFFILIATE_TEMPLATE_MAGALU=
AFFILIATE_TEMPLATE_AMERICANAS=
AFFILIATE_TEMPLATE_SHOPEE=
AFFILIATE_TEMPLATE_KABUM=
