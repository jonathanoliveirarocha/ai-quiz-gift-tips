# Chave da API do Gemini: https://aistudio.google.com/apikey (use um projeto com faturamento ativo).
# Sem chave, o site funciona em modo demonstracao (sugestoes sem IA).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo reserva, usado quando o principal falha ("none" desliga). Se os dois falharem, entra o acervo proprio.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Teto de chamadas de IA por dia (protege o custo). Acima dele, as ideias vem do acervo proprio.
MAX_AI_CALLS_PER_DAY=2000

# MongoDB. Se nao houver servidor nesse endereco, o backend sobe um MongoDB embutido
# com os dados em backend/.data (o primeiro start baixa o binario do MongoDB).
MONGODB_URI=mongodb://127.0.0.1:27017/presente-certo
MONGODB_EMBEDDED=true

PORT=3001

# Endereco(s) do frontend que podem chamar esta API, separados por virgula. Aceita * como curinga.
# Local: http://localhost:5173 | Vercel: https://seu-front.vercel.app,https://seu-front-*-seutime.vercel.app
CORS_ORIGIN=http://localhost:5173

# Token do painel (/painel no site) e da API /api/admin. Vazio = painel desativado.
ADMIN_TOKEN=

# Alertas (Discord, Slack ou Telegram): avisa quando a IA falha, o teto diario e atingido ou ha denuncias.
ALERT_WEBHOOK_URL=

# Anti-robo (opcional): chave secreta do Cloudflare Turnstile. Junto, defina VITE_TURNSTILE_SITE_KEY no frontend.
TURNSTILE_SECRET_KEY=

# ---------- Lojas e afiliados ----------
# Lojas com botao em cada ideia, na ordem dos botoes. Para incluir o Mercado Livre: amazon,shopee,mercadolivre
ACTIVE_STORES=amazon,shopee
# Amazon Associados: sua tag padrao, ex.: meusite-20
AMAZON_ASSOCIATE_TAG=
# Uma tag por canal, para saber de onde vem cada comissao (crie as tags no painel da Amazon).
# Ex.: AMAZON_TRACKING_IDS=instagram=meusite-ig-20,tiktok=meusite-tt-20
AMAZON_TRACKING_IDS=
# Shopee: API oficial de afiliados (recomendado). Produtos com foto, preco e link oficial.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Shopee sem API: modelo de link. {query} = termo de busca, {canal} = origem da visita, {url} = link codificado.
AFFILIATE_TEMPLATE_SHOPEE=
AFFILIATE_TEMPLATE_MERCADOLIVRE=
